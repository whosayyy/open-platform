<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yin</groupId>
        <artifactId>open-platform-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>open-platform-quickstart</artifactId>
    <name>Open Platform :: Quickstart</name>
    <description>
        面向业务开发者的极简门面：Agent.of(...).prompt(...).build().run(input)。
        只依赖 Core 与 Reactor，不需要了解 AgentRequest / ExecutionContext / ModelClient。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.yin</groupId>
            <artifactId>open-platform-core</artifactId>
        </dependency>

        <!-- Agent.stream() 的返回类型 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
