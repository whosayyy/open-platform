# Open Platform —— 示例用环境变量样例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）

# 例：examples/code-qa 的 LIVE 模型配置
# 不配置这些时，code-qa 默认走离线 STUB 模型，可正常跑测试与演示。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 可选：运行时行为
# CODE_QA_MODE=stub            # 强制离线模型
# CODE_QA_DEBUG=true           # 打印完整请求/响应体
# CODE_QA_CONNECT_TIMEOUT=20   # 连接超时（秒）
# CODE_QA_RETRY=2              # 连接类故障重试次数
